#!/usr/bin/env python
# -*- mode: python; coding: utf-8 -*-

import sys
import logging
import Ice

from client_base import ClientBase, ClientException
import DUO


class StringClient(ClientBase):
    def add_options(self):
        group = self.arg_parser.add_mutually_exclusive_group(required=True)
        group.add_argument(
            '--set', type=str, help="set object's value")
        group.add_argument(
            '--get', action='store_true', help="get object's value")

    def do_set(self):
        proxy = DUO.IString.WPrx.checkedCast(self.proxy)
        if proxy is None:
            raise ClientException("given proxy is not an IString.W")

        proxy.set(self.args.set, Ice.Identity())

    def do_get(self):
        proxy = DUO.IString.RPrx.checkedCast(self.proxy)
        if proxy is None:
            raise ClientException("given proxy is not an IString.R")

        value = proxy.get()
        logging.info("Value: {0}".format(value))


if __name__ == "__main__":
    StringClient().main(sys.argv, "../servers/icestorm-client.cfg")
