# -*- mode: python; coding: utf-8 -*-

import signal

istaf_port = 11000
istaf = TestBG(
    cwd = '$basedir/servers',
    pre = Not(OpenPort(istaf_port)),
    cmd = './duo-istaf',
    signal = signal.SIGINT,
    expected = -2)

active_port = 1234
active_proxy = "test -t:tcp -p {0}".format(active_port)
active = TestBG(
    pre = [Not(OpenPort(active_port)),
           Poll(OpenPort(istaf_port))],
    cwd = '$basedir/dummies',
    signal = signal.SIGINT,
    cmd = './duo-dummy-byte --host localhost --port {0} --id test --no-gui RWA'.
    format(active_port),
    post = StdErrContains('-> set(45'))

observer_port = 1235
observer = TestBG(
    pre = [Not(OpenPort(observer_port)),
           Poll(OpenPort(active_port))],
    cwd = '$basedir/dummies/',
    signal = signal.SIGINT,
	save_stderr = True,
    cmd = "./duo-dummy-byte --active-suscribe '{}' --host localhost --port {} --id test --no-gui W".format(active_proxy, observer_port))

client = Test(
    pre = [Poll(OpenPort(active_port)), Poll(OpenPort(observer_port))],
    cwd = '$basedir/clients',
    cmd = "./duo-client-byte '{0}' --set 45".format(active_proxy),
    post = Poll(FileContains('-> set(45', observer.stderr)))
