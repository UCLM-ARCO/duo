# -*- mode: python; coding: utf-8 -*-
import signal

port = 1234
dummy = TestBG(
    pre = Not(OpenPort(port)),
    cwd = '$basedir/dummy',
    signal = signal.SIGINT,
    cmd = './duo-dummy-bool --host localhost --port {port} --id test --no-gui W'.
    format(**locals()),
    post = StdErrContains('received set(True'))

proxy = "test -t:tcp -p {port}".format(**locals())
client = Test(
    pre = Poll(OpenPort(port), .05),
    cwd = '$basedir/clients',
    cmd = "./duo-client-bool '{0}' --set True".format(proxy))
