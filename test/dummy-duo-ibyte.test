# -*- mode: python; coding: utf-8 -*-
import signal

port = 1234
dummy = TestBG(
    pre = Not(OpenPort(port)),
    cwd = '$basedir/dummies',
    signal = signal.SIGINT,
    cmd = './duo-dummy-byte --host localhost --port {port} --id test --no-gui W'.
    format(**locals()),
    post = StdErrContains('-> set(152'))

proxy = "test -t:tcp -p {port}".format(**locals())
client = Test(
    pre = Poll(OpenPort(port), .05),
    cwd = '$basedir/clients',
    cmd = "./duo-client-byte '{0}' --set 152".format(proxy))
