#!/bin/sh
# -*- mode: sh; coding: utf-8 -*-

DB_DIR=/tmp/istaf-db

./duo-icestorm &
while ! fuser -n tcp 10000; do sleep 0.5; done
IS_PID=$(pidof icebox | awk '{print $NF}')

rm -fr "$DB_DIR"
mkdir -p  "$DB_DIR"
grep --color ISTopicAsFacet.TopicManager.Proxy istaf-client.cfg
pyicebox --Ice.Config=istaf.cfg

kill $IS_PID
